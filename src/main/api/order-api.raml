#%RAML 1.0
title: Order API
version: v1
baseUri: http://localhost:8081/api
mediaType: application/json

types:
  Order:
    type: object
    properties:
      id:
        type: string
        description: Unique identifier for the order
        example: "order-12345"
      productId:
        type: string
        description: Reference to product ID
        example: "prod-1"
        required: true
      quantity:
        type: integer
        description: Quantity of products ordered
        example: 2
        required: true
      status:
        type: string
        description: Order status
        enum: [pending, confirmed, shipped, delivered, cancelled]
        example: "pending"
        required: true
  
  OrderRequest:
    type: object
    properties:
      productId:
        type: string
        description: Reference to product ID
        example: "prod-1"
        required: true
      quantity:
        type: integer
        description: Quantity of products ordered
        example: 2
        required: true
      status:
        type: string
        description: Order status
        enum: [pending, confirmed, shipped, delivered, cancelled]
        example: "pending"
        required: true

  Error:
    type: object
    properties:
      message:
        type: string
        description: Error message
        example: "Order not found"
      code:
        type: string
        description: Error code
        example: "ORDER_NOT_FOUND"

/orders:
  displayName: Orders
  description: Operations on orders
  
  get:
    displayName: Get All Orders
    description: Retrieve all orders
    responses:
      200:
        body:
          application/json:
            type: Order[]
            example: |
              [
                {
                  "id": "order-1",
                  "productId": "prod-1",
                  "quantity": 2,
                  "status": "pending"
                },
                {
                  "id": "order-2",
                  "productId": "prod-2",
                  "quantity": 1,
                  "status": "confirmed"
                }
              ]
      500:
        body:
          application/json:
            type: Error
            example: |
              {
                "message": "Internal server error",
                "code": "INTERNAL_ERROR"
              }
  
  post:
    displayName: Create Order
    description: Create a new order
    body:
      application/json:
        type: OrderRequest
        example: |
          {
            "productId": "prod-1",
            "quantity": 3,
            "status": "pending"
          }
    responses:
      201:
        body:
          application/json:
            type: Order
            example: |
              {
                "id": "order-3",
                "productId": "prod-1",
                "quantity": 3,
                "status": "pending"
              }
      400:
        body:
          application/json:
            type: Error
            example: |
              {
                "message": "Invalid order data",
                "code": "INVALID_REQUEST"
              }
      500:
        body:
          application/json:
            type: Error

  /{id}:
    displayName: Order by ID
    description: Operations on a specific order
    
    get:
      displayName: Get Order by ID
      description: Retrieve a specific order by ID
      responses:
        200:
          body:
            application/json:
              type: Order
              example: |
                {
                  "id": "order-1",
                  "productId": "prod-1",
                  "quantity": 2,
                  "status": "pending"
                }
        404:
          body:
            application/json:
              type: Error
              example: |
                {
                  "message": "Order not found",
                  "code": "ORDER_NOT_FOUND"
                }
        500:
          body:
            application/json:
              type: Error
    
    put:
      displayName: Update Order
      description: Update an existing order
      body:
        application/json:
          type: OrderRequest
          example: |
            {
              "productId": "prod-1",
              "quantity": 5,
              "status": "confirmed"
            }
      responses:
        200:
          body:
            application/json:
              type: Order
              example: |
                {
                  "id": "order-1",
                  "productId": "prod-1",
                  "quantity": 5,
                  "status": "confirmed"
                }
        400:
          body:
            application/json:
              type: Error
              example: |
                {
                  "message": "Invalid order data",
                  "code": "INVALID_REQUEST"
                }
        404:
          body:
            application/json:
              type: Error
              example: |
                {
                  "message": "Order not found",
                  "code": "ORDER_NOT_FOUND"
                }
        500:
          body:
            application/json:
              type: Error